{
  "seed": 42,
  "image_size": 256,
  "paths": {
    "original": "data/original",
    "prepared": "data/prepared",
    "degraded": "data/degraded",
    "results": "results"
  },
  "degradations": {
    "gauss_low": {"type": "gaussian", "variance": 100},
    "gauss_high": {"type": "gaussian", "variance": 900},
    "impulse": {"type": "impulse", "prob": 0.05},
    "haze": {"type": "haze", "contrast": 0.5}
  },
  "metrics": {
    "ssim_window": 8,
    "ssim_step": 4
  },
  "stages": {
    "bilateral": {"radius": 2, "sigma_space": 2.0, "sigma_range": 60},
    "wiener": {"radius": 1},
    "saturation": {"factor": 1.5},
    "color_segment": {"hue_min": 40, "hue_max": 170, "sat_min": 0.15, "val_min": 0.1},
    "morphology": {"radius": 1}
  },
  "pipelines": {
    "pipeline1": ["bilateral", "equalize", "otsu"],
    "pipeline2": ["wiener", "saturation", "color_segment"],
    "pipeline2m": ["wiener", "saturation", "color_segment", "morphology"]
  },
  "scenarios": [
    {"id": 1, "kind": "gain", "pipelines": ["pipeline1", "pipeline2"], "degradation": "gauss_low",
     "min_gain": 1.0, "min_share": 0.9},
    {"id": 2, "kind": "gain", "pipelines": ["pipeline1", "pipeline2"], "degradation": "gauss_high",
     "min_gain": 3.0, "min_share": 0.9},
    {"id": 3, "kind": "gain", "pipelines": ["pipeline2"], "degradation": "impulse",
     "min_gain": 0.0, "min_share": 0.9},
    {"id": 4, "kind": "mean", "pipelines": ["pipeline1"], "field": "iou", "min_mean": 0.8},
    {"id": 5, "kind": "mean", "pipelines": ["pipeline2", "pipeline2m"], "field": "iou",
     "min_mean": 0.25}
  ],
  "save_intermediate": true
}